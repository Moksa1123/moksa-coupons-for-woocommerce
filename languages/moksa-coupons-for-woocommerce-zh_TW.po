msgstr "fixed_total 為整組總價;percent 為折扣 %(0–100)"

msgid "fixed_total: group fixed total / percent: group discount percentage"
msgstr "fixed_total 整組固定總價 / percent 整組折扣百分比"

msgid "once (only once) / repeat (repeatable) (default once)"
msgstr "once 只一次 / repeat 可重複(預設 once)"

msgid "once = one time only / repeat = repeatable (default repeat)"
msgstr "once 只一次 / repeat 可重複(預設 repeat)"

msgid "true = enable, false = disable"
msgstr "true=啟用、false=停用"

msgid "true = permanently delete, false = move to trash (default)"
msgstr "true=永久刪除、false=移到垃圾桶(預設)"
