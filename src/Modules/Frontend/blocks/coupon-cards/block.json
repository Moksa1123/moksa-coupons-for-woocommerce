{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "moksafocou/coupon-cards",
	"version": "1.0.0",
	"title": "Moksa coupon cards",
	"category": "widgets",
	"icon": "tickets-alt",
	"description": "Show the currently available coupon cards (same as the [moksafocou_coupons] shortcode).",
	"keywords": [ "coupon", "coupons", "moksafocou" ],
	"textdomain": "moksa-coupons-for-woocommerce",
	"attributes": {
		"limit": { "type": "number", "default": 20 }
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ]
	},
	"editorScript": "moksafocou-coupon-cards-editor",
	"style": "moksafocou-coupon-cards"
}
